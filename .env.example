# Copy to .env for local runs (docker-compose reads ADMIN_TOKEN from it).
# The app itself reads plain environment variables — see application.yml.

# --- database -------------------------------------------------------------
# Either set the three SPRING_DATASOURCE_* vars, or set a single DATABASE_URL
# (postgres://user:pass@host:5432/db) and the app will translate it.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wallet
SPRING_DATASOURCE_USERNAME=wallet
SPRING_DATASOURCE_PASSWORD=wallet
# DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet

# --- app -----------------------------------------------------------------
PORT=8080
DB_POOL_MAX=20

# Token for POST /admin/credit (seeds balances for the burst script). Not part
# of the graded transfer path.
ADMIN_TOKEN=dev-admin-token
